---
import Base from "../../layouts/base.astro"
---
<script>
    // @ts-nocheck
	import { OrbitControls } from 'three/examples/jsm/Addons.js'

    import {
        Scene,
        PerspectiveCamera,
        WebGLRenderer,
        AxesHelper,
        SphereGeometry,
        MeshBasicMaterial,
        Mesh,
        TextureLoader,
        MeshStandardMaterial,
        AmbientLight,
        PointLight
    } from 'three'

    //--------------------------- Data

    const solarSystemData = [
        {
            name: 'Sun',
            radius: 5,
            distance: 0,
            speed: 0,
            color: 'yellow',
            moons: [],
            animate: null,
            bg: 'alectrona_map_2k_by_greaterhtrae_dik6ipy-pre.jpg'
        },
        {
            name: 'Mercury',
            radius: 0.3,
            distance: 10,
            speed: -0.02,
            color: 0xaaaaaa,
            moons: [],
            animate: true,
            bg: 'mercury_map_2k_by_greaterhtrae_dgcn4yu-pre.jpg'
        },
        {
            name: 'Venus',
            radius: 0.9,
            distance: 15,
            speed: 0.015,
            color: 0xffcc66,
            moons: [],
            animate: true,
            bg: 'venus_map_2k_with_upside_down_by_greaterhtrae_dgawvs5-pre.jpg'
        },
        {
            name: 'Earth',
            radius: 1,
            distance: 20,
            speed: -0.01,
            color: 0x3399ff,
            moons: [
                {
                    name: 'Moon', 
                    radius: 0.3,
                    distance: 3,
                    speed: 0.05,
                    color: 0xdddddd
                }
            ],
            animate: true,
            bg: 'new_world_map__koi_1082304566_04e_aetheria_map__2k_by_greaterhtrae_djsbynd-pre.png'
        },
        {
            name: 'Mars',
            radius: 0.5,
            distance: 25,
            speed: 0.008,
            color: 0xff6633,
            moons: [
                {name: 'Phobos', radius: 0.3, distance: 2, speed: -0.05, color: 0xaaaaaa},
                {name: 'Deimos', radius: 0.3, distance: 2.8, speed: 0.05, color: 0xaaaaaa},
            ],
            animate: true,
            bg: 'mars_map_2k___gumball_by_greaterhtrae_difahzk-pre.jpg'
        },
        {
            name: 'Jupiter',
            radius: 3,
            distance: 35,
            speed: -0.005,
            color: 0xff9966,
            moons: [
                { name: 'Io', radius: 0.1, distance: 1.4, speed: -0.04, color: 0xffcc66 },
                { name: 'Europa', radius: 0.1, distance: 1.7, speed: 0.035, color: 0xffffff },
                { name: 'Ganymede', radius: 0.1, distance: 2, speed: -0.03, color: 0xcccccc },
                { name: 'Callisto', radius: 0.1, distance: 2.3, speed: 0.025, color: 0x999999 }
            ],
            animate: true,
            bg: 'jupiter_map_2k_by_greaterhtrae_dgcn2sl-pre.jpg'
        },
        {
            name: 'Saturn',
            radius: 2.5,
            distance: 50,
            speed: 0.004,
            color: 0xffcc99,
            moons: [
                { name: 'Titan', radius: 0.1, distance: 1.4, speed: -0.03, color: 0xffcc66 },
                { name: 'Rhea', radius: 0.1, distance: 1.7, speed: 0.028, color: 0xcccccc },
                { name: 'Iapetus', radius: 0.1, distance: 2, speed: -0.026, color: 0x999999 }
            ],
            animate: true,
            bg: 'saturn_map_2k_by_greaterhtrae_dhlulln-pre.jpg'
        },
        {
            name: 'Uranus',
            radius: 1.7,
            distance: 65,
            speed: -0.003,
            color: 0x66ccff,
            moons: [
                { name: 'Miranda', radius: 0.15, distance: 1.5, speed: -0.03, color: 0xcccccc },
                { name: 'Ariel', radius: 0.15, distance: 2, speed: 0.028, color: 0xaaaaaa },
                { name: 'Umbriel', radius: 0.15, distance: 2.5, speed: -0.026, color: 0x999999 },
                { name: 'Titania', radius: 0.15, distance: 3, speed: 0.024, color: 0x888888 },
                { name: 'Oberon', radius: 0.15, distance: 3.5, speed: -0.022, color: 0x777777 }
            ],
            animate: true,
            bg: 'uranus_map_2k_by_greaterhtrae_dhlumbg-pre.jpg'
        },
        {
            name: 'Neptune',
            radius: 1.6,
            distance: 75,
            speed: 0.002,
            color: 0x3366ff,
            moons: [
                { name: 'Triton', radius: 0.15, distance: 1.5, speed: 0.025, color: 0xcccccc }
            ],
            animate: true,
            bg: 'neptune_map_2k__true_color__by_greaterhtrae_di04wuj-pre.jpg'
        }
    ];

    //--------------------------- Init

    const scene = new Scene()
    const textureLoader = new TextureLoader()
    const sphereGeometry = new SphereGeometry(1, 32, 32)

    const camera = new PerspectiveCamera(35, window.innerWidth / window.innerHeight, 0.1, 400)
    camera.position.z = 100
    scene.add(camera)

    const canvas = document.querySelector('#main')
    const renderer = new WebGLRenderer({canvas, antialias: true, alpha: true})
    renderer.setClearColor(0x000000, 0);
    renderer.setSize(window.innerWidth, window.innerHeight)
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2))

    const controls = new OrbitControls(camera, canvas)
    controls.enableDamping = true

    const ambientLight = new AmbientLight(0xffffff, 0.1)
    scene.add(ambientLight)
    const pointLight = new PointLight(0xffffff, 500)
    scene.add(pointLight)

    window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight
        camera.updateProjectionMatrix()
        renderer.setSize(window.innerWidth, window.innerHeight)
    })

    const axesHelper = new AxesHelper(2)
    scene.add(axesHelper)

    const solarSystemElements = solarSystemData.map((ele) => {
        
        const solarSystemMesh = {
            mesh: null,
            moons: [],
            distance: ele.distance,
            speed: ele.speed,
            animate: ele.animate,
        }

        let baseMaterial = null
        if(ele.name == 'Sun') {
            baseMaterial = new MeshBasicMaterial({map: textureLoader.load(`/${ele.bg}`)})
        } else {
            baseMaterial = new MeshStandardMaterial({map: textureLoader.load(`/${ele.bg}`)})
        }
        const baseMesh = new Mesh(sphereGeometry, baseMaterial)
        baseMesh.scale.setScalar(ele.radius)
        baseMesh.position.x = ele.distance
        solarSystemMesh.mesh = baseMesh

        if(ele.moons?.length) {

            for(let moon of ele.moons) {
                const followerMaterial = new MeshStandardMaterial({color: moon.color})
                const followerMesh = new Mesh(sphereGeometry, followerMaterial)
                followerMesh.scale.setScalar(moon.radius)
                followerMesh.position.x = moon.distance
                solarSystemMesh.mesh.add(followerMesh)
                solarSystemMesh.moons.push({
                    mesh: followerMesh,
                    speed: moon.speed,
                    distance: moon.distance
                })
            }
        }

        return solarSystemMesh
    })

    //--------------------------- Helpers

    const animateSolarEle = (ele) => {

        ele.mesh.rotation.y += ele.speed
        ele.mesh.position.x = Math.sin(ele.mesh.rotation.y) * ele.distance
        ele.mesh.position.z = Math.cos(ele.mesh.rotation.y) * ele.distance

        if(ele.moons?.length) {

            ele.moons.forEach((moon) => {
                
                moon.mesh.rotation.y += moon.speed
                moon.mesh.position.x = Math.sin(moon.mesh.rotation.y) * moon.distance
                moon.mesh.position.z = Math.cos(moon.mesh.rotation.y) * moon.distance
            })
        }
    }

    //--------------------------- Stage

    solarSystemElements.forEach(ele => scene.add(ele.mesh))

    //--------------------------- Render
    const rendering = () => {

        // Stage animations
        solarSystemElements.forEach(ele => {
            if(ele.animate) animateSolarEle(ele)
        })

        renderer.render(scene, camera)
        controls.update()
        window.requestAnimationFrame(rendering)
    }

    rendering()
</script>
<style>
    body {
    margin: 0;
    padding: 0;
    overflow: hidden;

    canvas {
        display: block;
    }

    .bg {
        position: absolute;
        z-index: -1;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;

        &.bg-stars {
            background: url('/bg.jpg');
            background-size: cover;
        }
    }
}
</style>
<Base>
	<title>Interactive 3D Solar System - Live Demo | Three.js Tutorial</title>
	<meta name="description" content="Explore an interactive 3D model of the solar system, built with Three.js and WebGL. This is the live demo for our step-by-step tutorial for beginners.">
    <meta name="keywords" content="three.js, threejs tutorial, 3d solar system, webgl, javascript 3d, interactive demo, web development, astro" />
    <meta name="author" content="Andrew Saeed" />
    <meta property="og:title" content="Interactive 3D Solar System - A Three.js Demo" />
    <meta property="og:description" content="Explore an interactive 3D model of the solar system. A live demo for the step-by-step beginner's tutorial." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://andrewsaeed.dev/templates/threejs-3d-solar-system/" />
    <meta property="og:image" content="https://andrewsaeed.dev/three.js-3d-solar-system.webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A 3D rendering of the solar system with planets orbiting the sun, created with Three.js." />
    <meta property="og:locale" content="en_US" />

	<main slot="main">
		<div class="bg bg-stars"></div>
        <canvas id="main"></canvas>
	</main>
</Base>